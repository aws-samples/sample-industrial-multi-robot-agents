{
  "program": "car_door_spot_welding",
  "cell_id": "welding_cell_2_small",
  "version": "1.0.0",
  "description": "2x KUKA KR240 R2900-2 robots, spot-welding program for the FIXTURE_A car-door fixture. SYNTHETIC TARGETS: the 15 weld points are a 3x5 grid (x -1.15 / -0.975 / -0.8, y -1.8 .. -0.65, z 1.35) that is not derived from part CAD; the nearest sheet geometry in the fixture CAD lies about 0.2-0.4 m below them and no workpiece is modelled (no obstacle is_workpiece). W10, W13, W14 and W15 were moved off the grid away from the fixture voxels (placeholder: true, original_position = grid point) and need real CAD positions. Position and tool orientation are planned as SEPARATE stages: 'orientation' is vertical (top-down) so the motion between welds keeps the tool pointing down; 'weld_orientation' encodes the required lean and is applied by the planner as a terminal wrist adjustment AT each weld. The two outer columns lean 45 degrees (tool body outboard, electrode pointing inboard and down); the central column is vertical. approach_vector is the direction the TCP travels INTO the weld.",
  "trajectory_backend": "ompl",
  "extensions": {
    "strategy": {
      "parallel_within_group": true,
      "sequence_groups_order": [
        "structural",
        "secondary"
      ],
      "collision_avoidance": "collaborative_planner"
    },
    "cycle_time": {
      "target_s": 20.0,
      "max_s": 30.0
    },
    "weld_params": {
      "weld_type": "spot",
      "welding_duration_s": 2.0,
      "approach_offset_z": 0.05,
      "retract_offset_z": 0.05,
      "weld_phases": [
        {
          "phase": "approach",
          "type": "move"
        },
        {
          "phase": "contact",
          "type": "move"
        },
        {
          "phase": "squeeze",
          "type": "wait",
          "duration_s": 0.1
        },
        {
          "phase": "weld",
          "type": "weld_pulse",
          "duration_s": 2.0
        },
        {
          "phase": "hold",
          "type": "wait",
          "duration_s": 0.1
        },
        {
          "phase": "retract",
          "type": "move"
        }
      ]
    }
  },

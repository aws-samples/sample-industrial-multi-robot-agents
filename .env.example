# Credentials for the simulation stack — copy to `.env` and fill in.
#
#   cp .env.example .env   &&   edit .env
#
# docker compose auto-loads `.env` from this directory and interpolates these
# into every container (see scripts/generate_compose.py). `.env` is gitignored.
# Alternatively, `export` these in the shell you run `make sim` from.
#
# Only the variables for your chosen LLM_PROVIDER are required:
#   bedrock (default) -> the AWS_* variables
#   openai            -> OPENAI_API_KEY
#   ollama            -> none

# ── AWS / Amazon Bedrock ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only for temporary / STS (e.g. SSO) credentials:
AWS_SESSION_TOKEN=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── RoboBallet policy training (optional: make trainer) ──────────────────────
# Where training jobs run — the ONE switch: local | sagemaker.
#   local     inside the trainer container (CPU torch; TRAINER_GPU=1 +
#             TRAINER_TORCH_INDEX=cu124 for a GPU host); no AWS settings needed.
#   sagemaker a SageMaker job (costs money); needs the settings below.
POLICY_TRAINING_TARGET=local
# Local jobs at a time (they share the cores), and whether the trainer resumes
# local jobs a restart interrupted (else: make train-resume JOB=<job>).
LOCAL_TRAINING_MAX_JOBS=2
POLICY_TRAINING_AUTO_RESUME=0
# SageMaker only. Pin the account: a job is refused when the role or the caller
# is elsewhere.
AWS_ACCOUNT_ID=
SAGEMAKER_REGION=
SAGEMAKER_ROLE_ARN=
# s3://bucket/prefix — keep S3 Block Public Access on for this bucket.
POLICY_S3_URI=
# Optional: PyTorch training image (default: the AWS DLC for the region),
# instance type, max runtime (s), KMS key, managed spot.
SAGEMAKER_IMAGE_URI=
SAGEMAKER_INSTANCE_TYPE=ml.g5.2xlarge
SAGEMAKER_MAX_RUNTIME_S=86400
SAGEMAKER_KMS_KEY_ID=
SAGEMAKER_USE_SPOT=0
# Which installed policy the roboballet backend plans with (empty = current).
ROBOBALLET_POLICY=
